# Copy this file to .env and fill in real values. Never commit .env.

# Required. Sets the admin login password THE FIRST TIME the server
# boots against an empty database (it seeds a bcrypt hash into the
# admin_users table and is never read again after that — changing
# this later does nothing; use Settings > Change password instead).
ADMIN_PASSWORD=change-this-before-first-boot

# Port the API server listens on. Render sets this automatically for
# Web Services — you don't need to set it yourself there.
PORT=4000

# The frontend's origin — needed for CORS + cross-origin cookies.
# Local dev: the Vite dev server, e.g. http://localhost:5173
# Production: your Render Static Site's URL, e.g.
#   https://deeksha-portfolio.onrender.com
# Accepts a comma-separated list if you need to allow more than one.
ALLOWED_ORIGIN=http://localhost:5173

# development | production. Also controls session cookie attributes:
# production uses sameSite=none + secure=true (required for the
# frontend/backend to be on different HTTPS subdomains); development
# uses sameSite=lax + secure=false (works over plain localhost HTTP).
NODE_ENV=development

# Optional — full path to the SQLite database file. Falls back to
# server/data/app.db (local dev) if unset. On Render, point this at
# your persistent disk's mount path, e.g. /data/app.db
# DB_PATH=/data/app.db

# Optional — full path to the uploaded-images folder. Falls back to
# server/uploads (local dev) if unset. On Render, point this at your
# persistent disk's mount path, e.g. /data/uploads
# UPLOADS_DIR=/data/uploads

# --- Saving admin changes into the GitHub repo (see README: "Saving admin changes to GitHub") ---
# On hosting without a persistent disk, anything saved only on the server is lost on every
# restart. With these three set, every admin change is committed to server/content/ in the
# repo shortly after you make it, and loaded back whenever the server starts.
# Leave them unset in local development and nothing is committed.

# Fine-grained personal access token limited to THIS repository, with "Contents: Read and write".
# Treat it like a password: set it in Render's environment settings, never commit it.
# GITHUB_TOKEN=github_pat_...

# The repository, as owner/name.
# GITHUB_REPO=coderxdk-1812/deeksha-karthik

# Branch to save to (default: main).
# GITHUB_BRANCH=main

# How long to wait after your last change before committing, in milliseconds (default: 15000).
# CONTENT_SYNC_DEBOUNCE_MS=15000
