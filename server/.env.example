# Copy this file to .env and fill in real values. Never commit .env.

# Required. Sets the admin login password THE FIRST TIME the server
# boots against an empty database (it seeds a bcrypt hash into the
# admin_users table and is never read again after that — changing
# this later does nothing; use Settings > Change password instead).
ADMIN_PASSWORD=change-this-before-first-boot

# Port the API server listens on.
PORT=4000

# Origin the frontend dev server runs on — needed for CORS + cookies
# in development, where client and server are on different ports.
CORS_ORIGIN=http://localhost:5173

# development | production. In production the server also serves the
# built frontend from ../dist, so the admin cookie is same-origin.
NODE_ENV=development
