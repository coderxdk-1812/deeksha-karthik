# Copy this file to .env if you want to override the default. Never commit .env.
# Vite only exposes vars prefixed VITE_ to client code, and inlines them at build time.

# Base URL of the backend API. Leave unset for local dev — it
# defaults to http://localhost:4000, matching `npm run dev:server`.
# In production (Render Static Site), set this to your backend Web
# Service's URL, e.g. https://deeksha-portfolio-api.onrender.com
VITE_API_URL=http://localhost:4000
